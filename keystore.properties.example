# Copy to keystore.properties (gitignored) and fill in for release signing.
# Generate a keystore (example):
#   keytool -genkeypair -v -keystore contractproof-upload.jks -alias upload \
#     -keyalg RSA -keysize 2048 -validity 10000
#
# storeFile is relative to the repository root.

storeFile=contractproof-upload.jks
storePassword=change-me
keyAlias=upload
keyPassword=change-me

# If keystore.properties is missing, you may build a locally installable release APK with:
#   CONTRACTPROOF_USE_DEBUG_SIGNING=true ./scripts/assemble-release-apk.sh
# Do not distribute judge builds signed with the debug key.
