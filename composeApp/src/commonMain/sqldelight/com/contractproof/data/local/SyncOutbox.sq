CREATE TABLE sync_outbox (
    id TEXT NOT NULL PRIMARY KEY,
    organization_id TEXT NOT NULL,
    kind TEXT NOT NULL,
    service_job_id TEXT NOT NULL,
    requirement_id TEXT,
    dedupe_key TEXT NOT NULL,
    sync_status TEXT NOT NULL,
    attempt_count INTEGER NOT NULL DEFAULT 0,
    next_retry_at TEXT NOT NULL,
    last_error TEXT,
    created_at TEXT NOT NULL,
    updated_at TEXT NOT NULL
);

CREATE UNIQUE INDEX sync_outbox_dedupe_key ON sync_outbox(dedupe_key);

CREATE INDEX sync_outbox_ready_idx ON sync_outbox(sync_status, next_retry_at);

selectReady:
SELECT *
FROM sync_outbox
WHERE sync_status IN ('pending', 'failed', 'retrying')
  AND next_retry_at <= ?
ORDER BY created_at
LIMIT ?;

selectByDedupeKey:
SELECT *
FROM sync_outbox
WHERE dedupe_key = ?;

insertOrIgnore:
INSERT OR IGNORE INTO sync_outbox(
    id,
    organization_id,
    kind,
    service_job_id,
    requirement_id,
    dedupe_key,
    sync_status,
    attempt_count,
    next_retry_at,
    last_error,
    created_at,
    updated_at
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateStatus:
UPDATE sync_outbox
SET sync_status = ?,
    updated_at = ?,
    last_error = ?
WHERE id = ?;

updateForRetry:
UPDATE sync_outbox
SET sync_status = ?,
    attempt_count = ?,
    next_retry_at = ?,
    updated_at = ?,
    last_error = ?
WHERE id = ?;

deleteById:
DELETE FROM sync_outbox
WHERE id = ?;

resetForImmediateRetry:
UPDATE sync_outbox
SET sync_status = 'retrying',
    next_retry_at = ?,
    updated_at = ?
WHERE dedupe_key = ?;

countPendingOrRetrying:
SELECT COUNT(*)
FROM sync_outbox
WHERE sync_status IN ('pending', 'retrying');

countFailed:
SELECT COUNT(*)
FROM sync_outbox
WHERE sync_status = 'failed';
