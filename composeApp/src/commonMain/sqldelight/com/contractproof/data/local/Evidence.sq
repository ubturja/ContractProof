CREATE TABLE evidence_record (
    id TEXT NOT NULL PRIMARY KEY,
    organization_id TEXT NOT NULL,
    service_job_id TEXT NOT NULL,
    service_job_requirement_id TEXT NOT NULL,
    captured_by_user_id TEXT NOT NULL,
    captured_at TEXT NOT NULL,
    evidence_type TEXT NOT NULL,
    location_id TEXT,
    latitude REAL,
    longitude REAL,
    horizontal_accuracy_meters REAL,
    sync_status TEXT NOT NULL,
    received_at TEXT,
    is_demo INTEGER NOT NULL DEFAULT 0
);

CREATE UNIQUE INDEX evidence_record_requirement_key
    ON evidence_record(organization_id, service_job_requirement_id);

CREATE INDEX evidence_record_job_idx
    ON evidence_record(organization_id, service_job_id);

CREATE TABLE evidence_file (
    id TEXT NOT NULL PRIMARY KEY,
    organization_id TEXT NOT NULL,
    evidence_record_id TEXT NOT NULL,
    bucket TEXT NOT NULL,
    object_path TEXT NOT NULL,
    mime_type TEXT NOT NULL,
    byte_size INTEGER NOT NULL,
    sha256 TEXT NOT NULL,
    sync_status TEXT NOT NULL,
    uploaded_at TEXT,
    local_staging_path TEXT,
    upload_percent INTEGER,
    FOREIGN KEY(evidence_record_id) REFERENCES evidence_record(id) ON DELETE CASCADE
);

CREATE UNIQUE INDEX evidence_file_record_key ON evidence_file(evidence_record_id);

selectByRequirement:
SELECT *
FROM evidence_record
WHERE organization_id = ?
  AND service_job_requirement_id = ?;

selectForJob:
SELECT *
FROM evidence_record
WHERE organization_id = ?
  AND service_job_id = ?
ORDER BY captured_at;

selectFileByRecordId:
SELECT *
FROM evidence_file
WHERE evidence_record_id = ?;

deleteFileForRecord:
DELETE FROM evidence_file
WHERE evidence_record_id = ?;

upsertRecord:
INSERT OR REPLACE INTO evidence_record(
    id,
    organization_id,
    service_job_id,
    service_job_requirement_id,
    captured_by_user_id,
    captured_at,
    evidence_type,
    location_id,
    latitude,
    longitude,
    horizontal_accuracy_meters,
    sync_status,
    received_at,
    is_demo
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

upsertFile:
INSERT OR REPLACE INTO evidence_file(
    id,
    organization_id,
    evidence_record_id,
    bucket,
    object_path,
    mime_type,
    byte_size,
    sha256,
    sync_status,
    uploaded_at,
    local_staging_path,
    upload_percent
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateFileUploadPercent:
UPDATE evidence_file
SET upload_percent = ?
WHERE evidence_record_id = ?;
