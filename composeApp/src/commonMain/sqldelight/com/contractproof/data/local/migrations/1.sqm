CREATE TABLE evidence_record (
    id TEXT NOT NULL PRIMARY KEY,
    organization_id TEXT NOT NULL,
    service_job_id TEXT NOT NULL,
    service_job_requirement_id TEXT NOT NULL,
    captured_by_user_id TEXT NOT NULL,
    captured_at TEXT NOT NULL,
    evidence_type TEXT NOT NULL,
    location_id TEXT,
    latitude REAL,
    longitude REAL,
    horizontal_accuracy_meters REAL,
    sync_status TEXT NOT NULL,
    received_at TEXT,
    is_demo INTEGER NOT NULL DEFAULT 0
);

CREATE UNIQUE INDEX evidence_record_requirement_key
    ON evidence_record(organization_id, service_job_requirement_id);

CREATE INDEX evidence_record_job_idx
    ON evidence_record(organization_id, service_job_id);

CREATE TABLE evidence_file (
    id TEXT NOT NULL PRIMARY KEY,
    organization_id TEXT NOT NULL,
    evidence_record_id TEXT NOT NULL,
    bucket TEXT NOT NULL,
    object_path TEXT NOT NULL,
    mime_type TEXT NOT NULL,
    byte_size INTEGER NOT NULL,
    sha256 TEXT NOT NULL,
    sync_status TEXT NOT NULL,
    uploaded_at TEXT,
    local_staging_path TEXT,
    FOREIGN KEY(evidence_record_id) REFERENCES evidence_record(id) ON DELETE CASCADE
);

CREATE UNIQUE INDEX evidence_file_record_key ON evidence_file(evidence_record_id);
