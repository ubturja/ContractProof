{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contractproof.app/schemas/extraction-v1.json",
  "title": "ContractExtractionV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "extracted_at",
    "pipeline",
    "document",
    "visits",
    "requirements"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "status": {
      "type": "string",
      "const": "completed"
    },
    "extracted_at": {
      "type": "string",
      "minLength": 1
    },
    "pipeline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text_engine", "llm_provider", "llm_model", "used_fallback"],
      "properties": {
        "text_engine": { "type": "string", "minLength": 1 },
        "llm_provider": { "type": "string", "enum": ["gemini", "groq"] },
        "llm_model": { "type": "string", "minLength": 1 },
        "used_fallback": { "type": "boolean" }
      }
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["page_count", "text_char_count", "ocr_page_indexes", "warnings"],
      "properties": {
        "page_count": { "type": "integer", "minimum": 0 },
        "text_char_count": { "type": "integer", "minimum": 0 },
        "ocr_page_indexes": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1 }
        },
        "warnings": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "visits": {
      "type": "array",
      "items": { "$ref": "#/$defs/visitCandidate" }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/requirementCandidate" }
    }
  },
  "$defs": {
    "visitCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "weekday",
        "start_time",
        "end_time",
        "timezone",
        "starts_on"
      ],
      "properties": {
        "weekday": { "type": "integer", "minimum": 1, "maximum": 7 },
        "start_time": { "type": "string", "minLength": 1 },
        "end_time": { "type": "string", "minLength": 1 },
        "timezone": { "type": "string", "minLength": 1 },
        "starts_on": { "type": "string", "minLength": 1 },
        "ends_on": { "type": ["string", "null"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "requirementCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "task", "requires_photo", "is_mandatory"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "task": { "type": "string", "minLength": 1 },
        "requires_photo": { "type": "boolean" },
        "is_mandatory": { "type": "boolean" },
        "zone_code": { "type": ["string", "null"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidence_quote": { "type": ["string", "null"] }
      }
    }
  }
}
